namespace Collections;

// ЗАДАНИЕ 1. Хэш-таблица на голом массиве.
//
// Разрешено: обычные массивы (T[]), свои классы-узлы.
// Запрещено: Dictionary, HashSet, List, LINQ внутри реализации.
//
// Что нужно:
//   Put      — добавить пару или перезаписать значение по существующему ключу
//   TryGet   — найти значение по ключу
//   Remove   — удалить пару, вернуть true если она была
//   Count    — сколько пар лежит сейчас
//
// Обязательно:
//   * номер ячейки считается из key.GetHashCode()
//     не забудьте, что хэш бывает отрицательным
//   * коллизии обрабатываются (два ключа в одной ячейке)
//   * при заполнении больше ~75% массив растёт вдвое
//     и все пары раскладываются заново
public class SimpleMap<TKey, TValue>
{
    private Node[] buckets;
    private int count;
    private bool sixseven_procent()
    {
        int i = 0;
        int c = 0;
        while (i < buckets.Length)
        {
            if (buckets[i] != null)
            {
                c++;
            }
            i++;
        }
        return (c * 4) >= (buckets.Length * 3);
    } 

    public SimpleMap(int capacity = 16)
    {
        buckets = new Node[capacity];
        //throw new NotImplementedException();
    }

    public int Count => count; //throw new NotImplementedException();

    private class Node
    {
        public TKey Key;
        public TValue Value;
        public Node Next;

        public Node(TKey key, TValue value)
        {
            Key = key;
            Value = value;
            Next = null;
        }
    }
    
    public void Put(TKey key, TValue value)
    {
        int bucket = (key.GetHashCode() & 0x7FFFFFFF) % buckets.Length;
        if (buckets[bucket] == null)
        {

            buckets[bucket] = new Node(key, value);
            count++;
        }
        else
        {
            Node current = buckets[bucket];
            if (object.Equals(current.Key, key))
                {
                    current.Value = value;
                    return;
                }    
            while (current.Next != null)
            {   
                current = current.Next;
                if (object.Equals(current.Key, key))
                {
                    current.Value = value;
                    return;
                }
            }
            count++;
            current.Next = new Node(key, value);
        }
    }

    public bool TryGet(TKey key, out TValue value)
    {
        int bucket = (key.GetHashCode() & 0x7FFFFFFF) % buckets.Length;
        Node current = buckets[bucket];
        while (current != null)
        {
            if (object.Equals(current.Key, key))
            {
                value = current.Value;
                return true;
            }
            else
            {
                current = current.Next;
            }
        }
        value = default;
        return false;
        //throw new NotImplementedException();
    }

    public bool Remove(TKey key)
    {
        int bucket = (key.GetHashCode() & 0x7FFFFFFF) % buckets.Length;
        Node current = buckets[bucket];
        if (current == null)
        {
            return false;
        }
        if (object.Equals(current.Key, key))
        {
            buckets[bucket] = current.Next;
            count--;
            return true;
        }
        Node previous = current;
        current = current.Next;
        while (current != null)
        {
            if (object.Equals(current.Key, key))
            {
                previous.Next = current.Next;
                count--;
                return true;
            }

            previous = current;
            current = current.Next;

        }
        return false;
        //throw new NotImplementedException();
    }
}
